-- Enable autocompletion capabilities
local capabilities = cmp_nvim_lsp.default_capabilities()

-- Common on_attach function for keymaps and setup
local on_attach = function(client, bufnr)
  local opts = { buffer = bufnr, noremap = true, silent = true }
  vim.keymap.set('n', 'gd', vim.lsp.buf.definition, opts)  -- Go to definition
  vim.keymap.set('n', 'K', vim.lsp.buf.hover, opts)  -- Hover info
  vim.keymap.set('n', '<leader>rn', vim.lsp.buf.rename, opts)  -- Rename symbol
  -- Add more keymaps as needed
end

-- Setup servers
lspconfig.gopls.setup { on_attach = on_attach, capabilities = capabilities }  -- Go
lspconfig.intelephense.setup { on_attach = on_attach, capabilities = capabilities }  -- PHP
--lspconfig.phpactor.setup { on_attach = on_attach, capabilities = capabilities }  -- PHP
lspconfig.ts_ls.setup { on_attach = on_attach, capabilities = capabilities }  -- JS/TS
lspconfig.lua_ls.setup { on_attach = on_attach, capabilities = capabilities }  -- JS/TS
lspconfig.pyright.setup { on_attach = on_attach, capabilities = capabilities }  -- Python
